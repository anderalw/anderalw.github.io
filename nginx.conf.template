# Site (SPA) + repasse da API e das fotos. ${API_UPSTREAM} vem do ambiente
server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Envio de fotos (logo, capa, avatar)
  client_max_body_size 10m;

  # API: /api/sessions -> http://api:3333/sessions
  location /api/ {
    proxy_pass ${API_UPSTREAM}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Fotos enviadas
  location /files/ {
    proxy_pass ${API_UPSTREAM}/files/;
    proxy_set_header Host $host;
  }

  # Arquivos do build têm hash no nome: cache longo
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # Rotas do React (ex.: /agendar) caem no index.html
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
